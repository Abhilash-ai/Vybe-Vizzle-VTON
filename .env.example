# ==============================================================================
# VIZZLE VTON · Environment Configuration
# AM Studio · Production Architecture
# ==============================================================================

# Core Settings
ENVIRONMENT=development
PROJECT_NAME="Vizzle VTON"
DEMO_MODE=true

# Active VTON Provider: demo | fashn | huggingface | replicate
VTON_PROVIDER=demo

# Security & Auth
SECRET_KEY=am-studio-vizzle-vton-super-secret-key-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default / PostgreSQL for production)
DATABASE_URL=sqlite:///./backend/data/vizzle_vton.db
# DATABASE_URL=postgresql://user:password@localhost:5432/vizzle_vton_db

# Commercial VTON Provider Credentials (Optional - for real remote neural diffusion)
FASHN_API_KEY=
FASHN_API_URL=https://api.fashn.ai/v1

# Serverless GPU / Open-Source Providers (Optional)
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=viktorfa/oot_diffusion

HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL_ENDPOINT=

# Storage & CORS
MAX_UPLOAD_SIZE_MB=15
VITE_API_URL=http://localhost:8000/api/v1
