# Environment Configuration for VYBE (Vizzle Virtual Try-On Benchmarking Engine)

ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1
SECRET_KEY=generate_a_secure_random_key_here_for_jwt_and_sessions
DATABASE_URL=sqlite:///./data/vybe.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Optional External VTON Provider Credentials
# 1. Commercial Cloud API: FASHN AI (https://fashn.ai/)
FASHN_API_KEY=

# 2. Serverless Diffusion: Replicate (https://replicate.com/) for OOTDiffusion
REPLICATE_API_TOKEN=

# 3. Dedicated / Serverless GPU Endpoint for CatVTON (Modal / RunPod / Custom FastAPI worker)
CATVTON_ENDPOINT_URL=

# 4. Dedicated / Serverless GPU Endpoint for IDM-VTON (A100 GPU worker)
IDMVTON_ENDPOINT_URL=
